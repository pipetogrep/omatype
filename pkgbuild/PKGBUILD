# Maintainer: pipetogrep
# Original author (OmaFont): Gavin Nugent (28allday)

pkgname=omatype
pkgver=0.2.0
pkgrel=1
pkgdesc='Open-source font browser and manager for Omarchy: discover, preview, compare and 1-click install typefaces'
arch=('x86_64' 'aarch64')
url='https://github.com/pipetogrep/omatype'
license=('MIT')
install='omatype.install'
options=('!debug')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'fontconfig' 'libarchive' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

# Builds the working tree; ./bin/install runs it.
build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omatype "$pkgdir/usr/bin/omatype"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 src/ui/icons/LICENSE.lucide "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lucide"
  /usr/bin/install -Dm644 "$startdir/omatype.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omatype.svg"
  /usr/bin/install -Dm644 "$startdir/omatype.desktop" "$pkgdir/usr/share/applications/omatype.desktop"
}
