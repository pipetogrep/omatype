        <file alias="TextArea.qml">style/OmaTypeStyle/TextArea.qml</file>
        <file alias="TextField.qml">style/OmaTypeStyle/TextField.qml</file>
        <file alias="ToolButton.qml">style/OmaTypeStyle/ToolButton.qml</file>
        <file alias="ToolTip.qml">style/OmaTypeStyle/ToolTip.qml</file>
    </qresource>
</RCC>
