        <file alias="Button.qml">style/OmaTypeStyle/Button.qml</file>
        <file alias="CheckBox.qml">style/OmaTypeStyle/CheckBox.qml</file>
        <file alias="ComboBox.qml">style/OmaTypeStyle/ComboBox.qml</file>
        <file alias="Dialog.qml">style/OmaTypeStyle/Dialog.qml</file>
        <file alias="DialogButtonBox.qml">style/OmaTypeStyle/DialogButtonBox.qml</file>
        <file alias="ItemDelegate.qml">style/OmaTypeStyle/ItemDelegate.qml</file>
        <file alias="Label.qml">style/OmaTypeStyle/Label.qml</file>
        <file alias="Menu.qml">style/OmaTypeStyle/Menu.qml</file>
        <file alias="MenuBar.qml">style/OmaTypeStyle/MenuBar.qml</file>
        <file alias="MenuBarItem.qml">style/OmaTypeStyle/MenuBarItem.qml</file>
        <file alias="MenuItem.qml">style/OmaTypeStyle/MenuItem.qml</file>
        <file alias="MenuSeparator.qml">style/OmaTypeStyle/MenuSeparator.qml</file>
        <file alias="Popup.qml">style/OmaTypeStyle/Popup.qml</file>
        <file alias="ScrollBar.qml">style/OmaTypeStyle/ScrollBar.qml</file>
        <file alias="ScrollIndicator.qml">style/OmaTypeStyle/ScrollIndicator.qml</file>
